{
  "name": "@plaintask/desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Plaintask desktop app (Tauri 2). macOS first.",
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit",
    "check:rust": "node build.mjs && cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets --locked -- -D warnings && cargo test --manifest-path src-tauri/Cargo.toml --locked",
    "tauri": "tauri",
    "app": "node scripts/build-app.mjs",
    "measure": "node scripts/measure-launch.mjs"
  },
  "devDependencies": {
    "@tauri-apps/api": "^2.12.5",
    "@tauri-apps/cli": "^2.12.6",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  }
}
