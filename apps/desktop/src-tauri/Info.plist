<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Merged into the app's Info.plist by tauri build. Sparkle's settings: src-tauri/src/update.rs. -->
<plist version="1.0">
<dict>
  <key>SUFeedURL</key>
  <string>https://github.com/airshiplabs/plaintask/releases/latest/download/appcast.xml</string>
  <!-- The release key's public half: generate_keys prints it (release skill, references/setup.md). -->
  <key>SUPublicEDKey</key>
  <string>PUBKEY</string>
  <!-- Installs through Sparkle's Installer.xpc, the way a sandboxed app can. -->
  <key>SUEnableInstallerLauncherService</key>
  <true/>
  <!-- The app runs its own checks and shows a toast; Sparkle never checks on its own or installs on quit. -->
  <key>SUEnableAutomaticChecks</key>
  <false/>
  <key>SUAllowsAutomaticUpdates</key>
  <false/>
</dict>
</plist>
