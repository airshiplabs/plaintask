{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Plaintask",
  "version": "0.2.0",
  "identifier": "com.airshiplabs.plaintask",
  "build": {
    "frontendDist": "../dist",
    "beforeBuildCommand": "node build.mjs",
    "beforeDevCommand": "node build.mjs"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Plaintask",
        "width": 880,
        "height": 620,
        "minWidth": 640,
        "minHeight": 400,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": ["icons/icon.icns"],
    "macOS": {
      "entitlements": "Entitlements.plist",
      "signingIdentity": "-"
    }
  }
}
